# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your actual `.env` file containing API keys to source control!
# ==============================================================================

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER=gemini

# Primary LLM API Keys (fill in whichever provider you are using)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
# Recommended for Gemini: gemini-1.5-flash or gemini-2.0-flash
# Recommended for OpenAI: gpt-4o-mini or gpt-4o
LLM_MODEL=gemini-1.5-flash
JUDGE_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Project Paths
DATA_DIR=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
GOLDEN_SET_PATH=./golden_set
RESULTS_DIR=./results

# Reproducibility & Runtime Settings
RANDOM_SEED=42
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_DIR=./.cache
MAX_RETRIEVAL_K=3
